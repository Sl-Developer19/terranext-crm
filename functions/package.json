{
  "name": "terranext-business-os-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for TerraNext Business OS (inventory: docs/19)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/error-reporting": "^3.0.6",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0",
    "google-auth-library": "^9.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
