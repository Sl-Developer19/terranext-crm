    function can_users_create() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_users_update() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_users_delete() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_users_assign() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_users_approve() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_users_export() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_users_configure() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_roles_create() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_update() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_delete() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_assign() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_approve() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_export() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_roles_configure() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_audit_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_audit_create() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_audit_update() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_audit_delete() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_audit_assign() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_audit_approve() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_audit_export() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_audit_configure() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_settings_create() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_update() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_delete() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_assign() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_approve() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_export() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_settings_configure() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_aiIntelligence_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin', 'ops_manager', 'coordinator', 'trainer'];
    }
    function can_aiIntelligence_create() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin', 'trainer'];
    }
    function can_aiIntelligence_update() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin', 'trainer'];
    }
    function can_aiIntelligence_delete() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_aiIntelligence_assign() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_aiIntelligence_approve() {
      return isStaff() && request.auth.token.role in ['founder'];
    }
    function can_aiIntelligence_export() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin', 'ops_manager'];
    }
    function can_aiIntelligence_configure() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }

    // Usage in rules: instead of 'can("leads", "view")',
    // call can_leads_view(), can_users_create(), etc.
    // <<GENERATED_RBAC_END>>

    // ── leads/* (Doc 03 §1.3, Doc 18, Doc 25 §5) ────────────────────────────
    // Read: ops_manager/founder see every lead; consultants see only leads
    //   assigned to them (Doc 10 §2 row-level scope); a Growth Partner sees
    //   only leads they referred (`partnerId` match, ADR-014) — never routed
    //   through `can_leads_view()`, which is staff-only by construction.
    //   Write: Admin SDK only — all lead mutations go through server actions
    //   (create/update/assign/log-activity/createPartnerLead) so BR-07
    //   dedupe-never-rejects and the audit trail stay enforced in one place.
    match /leads/{leadId} {
      allow read: if (can_leads_view() && (
        hasRole('founder') || hasRole('ops_manager') || resource.data.assignedToUid == request.auth.uid
      )) || isOwnPartnerRecord(resource.data.partnerId);
      allow write: if false; // Admin SDK only

      match /activities/{activityId} {
        allow read: if (can_leads_view() && (
          hasRole('founder') || hasRole('ops_manager') ||
          get(/databases/$(database)/documents/leads/$(leadId)).data.assignedToUid == request.auth.uid
        )) || isOwnPartnerRecord(get(/databases/$(database)/documents/leads/$(leadId)).data.partnerId);
        allow write: if false; // Admin SDK only
      }
    }

    // ── academies/* + programmes/* (Doc 03 §1.2, S22 catalogue) ─────────────
    // Read: any role with `programmes:view` — the catalogue is picklist data
    //   the whole app depends on. Write: Admin SDK only, so the BR-03
    //   certificate thresholds and default fee plans cannot be edited except
    //   through an audited server action.
    match /academies/{academyId} {
      allow read: if can_programmes_view();
      allow write: if false; // Admin SDK only
    }
    match /programmes/{programmeId} {
      allow read: if can_programmes_view();
      allow write: if false; // Admin SDK only
    }

    // ── batches/* (Doc 03 §1.2/§1.5, Doc 14 §7, BR-04) ──────────────────────
    // Read: any role with `batches:view`. Trainers see all batches here and
    //   are scoped to their own only for attendance WRITES (Doc 18) — seeing
    //   the schedule is not the sensitive operation.
    // Write: Admin SDK only. `enrolledCount` is the BR-04 capacity counter and
    //   may only move inside the allocation transaction; a client-writable
    //   counter is exactly how overbooking happens.
    match /batches/{batchId} {
      allow read: if can_batches_view();
      allow write: if false; // Admin SDK only

      match /sessions/{sessionId} {
        allow read: if can_batches_view();
        allow write: if false; // Admin SDK only

        // Attendance marks. Doc 10 §3 anticipated trainer-scoped CLIENT
        // writes validated here; the implementation runs them through a
        // server action instead, because the attendancePct roll-up recompute
        // is server-side regardless and splitting the write across two trust
        // tiers would duplicate the trainer↔batch rule. Default-deny here is
        // strictly more restrictive than the blueprint proposed.
        match /attendance/{participantId} {
          allow read: if can_attendance_view();
          allow write: if false; // Admin SDK only (markAttendance action)
        }
      }
    }

    // ── assessments/* (Doc 03 §1.5, Doc 14 §12) ─────────────────────────────
    // Read: any role with `assessments:view`. Write: Admin SDK only — the
    //   pass/fail verdict is derived server-side from the pass mark, so a
    //   client-writable `result` field would let a tampered write manufacture
    //   a pass that BR-03 certificate issuance would then honour.
    match /assessments/{assessmentId} {
      allow read: if can_assessments_view();
      allow write: if false; // Admin SDK only

      match /scores/{participantId} {
        allow read: if can_assessments_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── certificates/* + alumniRecords/* (Doc 03 §1.5/§1.6, BR-03/BR-05) ────
    // Read: any role with the matching view grant. Write: Admin SDK only —
    //   the BR-03 evidence snapshot and the issuance counter are the entire
    //   integrity story for certificates, and neither survives a client
    //   write path. Public verification goes through the unauthenticated
    //   /api/certificates/verify route, which returns no PII, not through
    //   a client read of this collection.
    match /certificates/{certificateId} {
      allow read: if can_certificates_view();
      allow write: if false; // Admin SDK only
    }
    match /alumniRecords/{participantId} {
      allow read: if can_alumni_view();
      allow write: if false; // Admin SDK only (BR-05)
    }

    // ── certificateTemplates/* + versions/* (Certificate Template Engine) ──
    // Read: any role with `certificates:view` — staff need to see which
    //   template a certificate came from. Write: Admin SDK only, gated on
    //   `certificates:configure` inside the server actions (system_admin/
    //   founder only) — never client-writable, same posture as the
    //   certificates collection itself: template lifecycle transitions
    //   (submit/approve/activate/archive) are integrity-critical and must
    //   not be reachable from a tampered client write.
    match /certificateTemplates/{templateId} {
      allow read: if can_certificates_view();
      allow write: if false; // Admin SDK only

      match /versions/{versionId} {
        allow read: if can_certificates_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── feeAccounts/* (Doc 03 §1.7, ADR-012) ────────────────────────────────
    // Read: any role with `fees:view` (founder, ops_manager, finance).
    // Write: Admin SDK only. `payments` is an append-only ledger whose
    //   totals must always reconcile; a client write path would allow an
    //   edited or deleted payment, which is precisely what the reversing-
    //   entry design exists to prevent.
    match /feeAccounts/{feeAccountId} {
      allow read: if can_fees_view();
      allow write: if false; // Admin SDK only

      match /payments/{paymentId} {
        allow read: if can_fees_view();
        allow write: if false; // Admin SDK only — append-only ledger
      }
    }

    // ── families/* (parent-first path, Doc 03 §8 Q3) ────────────────────────
    // Read: any role with `parents:view`. Write: Admin SDK only — parent
    //   conversion mints a `leads` document and rolls the household's
    //   conversion status up, neither of which a client write could keep
    //   consistent. Counselling sessions are the evidence a conversion is
    //   gated on, so they are no more client-writable than the lead itself.
    match /families/{familyId} {
      allow read: if can_parents_view();
      allow write: if false; // Admin SDK only

      match /parents/{parentId} {
        allow read: if can_parents_view();
        allow write: if false; // Admin SDK only
      }
      match /sessions/{sessionId} {
        allow read: if can_parents_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── careerProfiles/* (Doc 03 §1.6, BR-09) ───────────────────────────────
    // Read: any role with `career:view`. Write: Admin SDK only — BR-09
    //   eligibility is a human decision that must always carry an audited
    //   note; a client-writable `eligibility` field would let it be set
    //   without one.
    match /careerProfiles/{participantId} {
      allow read: if can_career_view();
      allow write: if false; // Admin SDK only

      match /guidanceSessions/{sessionId} {
        allow read: if can_career_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── employers/* (Doc 03 §1.6, Doc 14 §15, S32) ──────────────────────────
    // Read: any role with `employers:view`. Write: Admin SDK only, like every
    //   other staff-side collection — mutations flow through server actions
    //   so name-uniqueness checks and audit logging can't be bypassed.
    match /employers/{employerId} {
      allow read: if can_employers_view();
      allow write: if false; // Admin SDK only
    }

    // ── placements/* (Doc 03 §1.6, Doc 14 §16, BR-08, BR-09) ────────────────
    // Read: any role with `placements:view`. Write: Admin SDK only — creation
    //   must check the linked career profile is `eligible` (BR-09) and every
    //   stage advance must append an audited statusHistory entry, neither of
    //   which rules can safely enforce on their own.
    // BR-08 (zero placement fee) has NO field-level rule constraint here —
    //   it is enforced entirely server-side (Zod schema never accepts a fee
    //   field from the client; `placements/repository.ts` hardcodes
    //   `terranextFeePaise: 0`). That is safe only because `write: if false`
    //   blocks every client write outright. If this rule is EVER loosened to
    //   permit any client write, `request.resource.data.feeDisclosure.terranextFeePaise == 0`
    //   MUST be added to that allow clause — do not loosen this rule without
    //   it (Doc 27 amendment, 2026-07-26 review).
    match /placements/{placementId} {
      allow read: if can_placements_view();
      allow write: if false; // Admin SDK only
    }

    // ── colleges/* + campusLeaders/* (Doc 14 §10, S15) ──────────────────────
    // Read: any role with `colleges:view`. Write: Admin SDK only — name
    //   uniqueness and audit logging live in the server action, and a client
    //   write path would bypass both.
    match /colleges/{collegeId} {
      allow read: if can_colleges_view();
      allow write: if false; // Admin SDK only

      match /campusLeaders/{leaderId} {
        allow read: if can_colleges_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── counsellingSessions/* (Doc 03 §1.3, Doc 14 §9, BR-02, S12) ──────────
    // Read: any role with `counselling:view`. Write: Admin SDK only — this
    //   collection is the evidence BR-02 gates admissions on, and the shape
    //   rule (outcome `recommended` requires a non-null recommendation) is
    //   re-checked in the server action against a real programme. A client
    //   write path could mint the recommendation an admission rests on.
    match /counsellingSessions/{sessionId} {
      allow read: if can_counselling_view();
      allow write: if false; // Admin SDK only (BR-02 evidence)
    }

    // ── communications/* (Doc 03 §1.7, Doc 14 §19, FR-10.3, S41) ────────────
    // Read: any role with `communications:view`. Write: Admin SDK only.
    //   Doc 18 sketched a staff manual-log create (`byUid == uid`), but the
    //   send path in this build goes through a server action that must write
    //   the log doc *before* dispatch — a client create path would let a
    //   message be sent with no log entry, which is the one thing FR-10.3
    //   exists to prevent. Status transitions (queued→sent/failed) belong to
    //   the dispatch worker for the same reason.
    match /communications/{communicationId} {
      allow read: if can_communications_view();
      allow write: if false; // Admin SDK only (FR-10.3 log-before-send)
    }

    // ── participants/* (Doc 03 §1.4, Doc 14 §11, BR-01) ─────────────────────
    // Read: every role with `participants:view` — the directory is shared
    //   across the whole staff. Field-level scoping (finance sees fee fields,
    //   placement sees career fields) is applied by server-side projection
    //   (Doc 10 §2), not by rules, since rules cannot filter fields on read.
    // Write: Admin SDK only. Participant IDs come from a transactional
    //   counter and every mutation is audited — allowing client writes would
    //   put BR-01 uniqueness and BR-06 audit coverage on the honour system.
    match /participants/{participantId} {
      allow read: if can_participants_view();
      allow write: if false; // Admin SDK only

      match /enrolments/{enrolmentId} {
        allow read: if can_participants_view();
        allow write: if false; // Admin SDK only
      }
      match /timeline/{entryId} {
        allow read: if can_participants_view();
        allow write: if false; // Admin SDK only — append-only via server actions
      }
      match /documents/{documentId} {
        allow read: if can_participants_view();
        allow write: if false; // Admin SDK only (signed-URL flow, Doc 10 §6)
      }
    }

    // ── growthPartners/* (Doc 25 §3/§5, ADR-014) ────────────────────────────
    // Read: staff with `growthPartners:view` (org-wide oversight, no row
    //   scope) OR the partner reading their own profile. Write: Admin SDK
    //   only — registration/approval/status changes mint Firebase Auth users
    //   and custom claims, which no rule can safely express.
    match /growthPartners/{partnerId} {
      allow read: if can_growthPartners_view() || isOwnPartnerRecord(partnerId);
      allow write: if false; // Admin SDK only
    }

    // ── leadershipLevels/* (Settings §3 — Growth Partner recognition tiers) ─
    // Admin-defined, not hardcoded (see features/leadership-levels). Read:
    // staff with `growthPartners:view` OR any signed-in partner (not
    // row-scoped like their own profile — the level list is shared reference
    // data, not partner-specific). Write: Admin SDK only, same as every
    // other catalogue-shaped collection (academies/programmes) — level
    // definitions are configuration, not a client-writable resource.
    match /leadershipLevels/{levelId} {
      allow read: if can_growthPartners_view() || isPartner();
      allow write: if false; // Admin SDK only
    }

    // ── communityPartners/* (TerraNext Community Growth Network, TCGN) ─────
    // A business/organisation referral partner — a distinct bounded context
    // from `growthPartners` (individual ambassadors), sharing the same
    // `isPartner()`/`isOwnPartnerRecord()` predicates and the same
    // `growthPartners:view` permission for staff oversight (no new RBAC
    // module — approved architecture: reuse, don't fork). Read: staff with
    // `growthPartners:view` (org-wide oversight) OR the partner reading their
    // own profile. Write: Admin SDK only — registration/approval/status
    // changes mint Firebase Auth users and custom claims, which no rule can
    // safely express.
    match /communityPartners/{partnerId} {
      allow read: if can_growthPartners_view() || isOwnPartnerRecord(partnerId);
      allow write: if false; // Admin SDK only
    }

    // ── rewardRules/* (Doc 25 §3) ───────────────────────────────────────────
    // Read: staff with `rewards:view` (oversight) OR any authenticated
    //   partner (a partner is entitled to know how rewards are calculated).
    //   Write: Admin SDK only — `rewards:configure`, System Admin only.
    match /rewardRules/{ruleId} {
      allow read: if can_rewards_view() || isPartner();
      allow write: if false; // Admin SDK only
    }

    // ── rewardLedger/* (Doc 25 §10/§12/§13) ─────────────────────────────────
    // Read: staff with `rewards:view` (oversight, all partners) OR the
    //   referred partner's own entries. Write: Admin SDK only — every entry
    //   is generated inside the fees payment transaction (recordPaymentRecord),
    //   the same immutable, append-only posture as auditLogs (ADR-007).
    match /rewardLedger/{ledgerId} {
      allow read: if can_rewards_view() || isOwnPartnerRecord(resource.data.partnerId);
      allow write: if false; // Admin SDK only
    }

    // ── wallets/* (Doc 25 §12) ───────────────────────────────────────────────
    // Read: staff with `rewards:view` OR the owning partner. Write: Admin SDK
    //   only — `balancePaise` only ever moves inside the same transaction as
    //   a `transactions` entry (reward credit or payout debit); a
    //   client-writable balance is exactly how a wallet stops reconciling.
    match /wallets/{partnerId} {
      allow read: if can_rewards_view() || isOwnPartnerRecord(partnerId);
      allow write: if false; // Admin SDK only

      match /transactions/{txId} {
        allow read: if can_rewards_view() || isOwnPartnerRecord(partnerId);
        allow write: if false; // Admin SDK only — append-only ledger
      }
    }

    // ── payoutRequests/* (Doc 25 §9/§13) ────────────────────────────────────
    // Read: staff with `rewards:view` (oversight) OR the requesting partner.
    //   Write: Admin SDK only — every transition (request/approve/reject/
    //   paid) is a transactional wallet+ledger operation a rule cannot
    //   safely express.
    match /payoutRequests/{payoutId} {
      allow read: if can_rewards_view() || isOwnPartnerRecord(resource.data.partnerId);
      allow write: if false; // Admin SDK only
    }

    // ── partnerNotifications/* (Doc 25 §14) ─────────────────────────────────
    // Read: the owning partner only — this is not staff oversight data.
    // Write: Admin SDK only (notifyPartner()).
    match /partnerNotifications/{partnerId} {
      match /items/{itemId} {
        allow read: if isOwnPartnerRecord(partnerId);
        allow write: if false; // Admin SDK only
      }
    }

    // ── aiSessions/* (AI Intelligence Platform — session recording) ────────
    // Read: any role with `aiIntelligence:view`. Write: Admin SDK only — a
    //   session's audio path, status, and links to its transcript/summary
    //   are set by server actions (upload ticket flow, Doc 10 §6 pattern)
    //   and by the processing pipeline; a client write path could forge a
    //   `completed` status with no transcript ever having been generated.
    match /aiSessions/{sessionId} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only

      // ── chunks/* (long-session support: ~10-minute recording segments) ──
      // Read: any role with `aiIntelligence:view`. Write: Admin SDK only —
      //   chunk upload state is set by requestChunkUploadTicket/
      //   confirmChunkUpload (server actions) and later by
      //   processAiSessionJob as each chunk is transcribed.
      match /chunks/{chunkId} {
        allow read: if can_aiIntelligence_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── aiProcessingJobs/* (AI Intelligence Platform — processing queue) ───
    // Read: any role with `aiIntelligence:view` — the Processing Queue and
    //   Dashboard pages poll this collection for realtime stage/progress.
    // Write: Admin SDK only — stage transitions are driven exclusively by
    //   the `processAiSessionJob` Cloud Function and the `retryProcessingJob`
    //   server action, never by the browser.
    match /aiProcessingJobs/{jobId} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only
    }

    // ── aiTranscripts/* (AI Intelligence Platform — Transcript Center) ─────
    // Read: any role with `aiIntelligence:view`. Write: Admin SDK only —
    //   written once by the processing pipeline after speech-to-text and
    //   trainer/student classification complete.
    match /aiTranscripts/{transcriptId} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only
    }

    // ── aiSummaries/* (AI Intelligence Platform — AI-generated knowledge) ──
    // Read: any role with `aiIntelligence:view`. Write: Admin SDK only —
    //   the executive summary, key learning points, questions, and action
    //   items are model output the pipeline writes once per session.
    match /aiSummaries/{summaryId} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only
    }

    // ── aiAnalytics/* (AI Intelligence Platform — daily rollups) ───────────
    // Read: any role with `aiIntelligence:view`. Write: Admin SDK only —
    //   counters are incremented transactionally by the processing pipeline
    //   as each session completes; a client-writable counter would drift
    //   from the sessions it is supposed to summarise.
    match /aiAnalytics/{day} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only
    }

    // ── aiIntelligenceSettings/* (AI Intelligence Platform — module config) ─
    // Read: any role with `aiIntelligence:view`. Write: Admin SDK only via
    //   the `updateAiSettings` server action, gated on `aiIntelligence:configure`.
    match /aiIntelligenceSettings/{configId} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only
    }

    // ── aiSessionChats/* (AI Intelligence Platform — AI Session Assistant) ──
    // Read: any role with `aiIntelligence:view` — same visibility as the
    //   transcript/summary this chat is grounded in. Write: Admin SDK only —
    //   every message (both the trainer's question and the model's answer)
    //   is written by the `askSessionAssistant` server action after its own
    //   permission check; the browser never writes a chat message directly,
    //   which is what makes a forged "assistant" reply impossible.
    match /aiSessionChats/{sessionId} {
      allow read: if can_aiIntelligence_view();
      allow write: if false; // Admin SDK only

      match /messages/{messageId} {
        allow read: if can_aiIntelligence_view();
        allow write: if false; // Admin SDK only
      }
    }

    // ── aiAssistantRateLimit/* (AI Intelligence Platform — assistant abuse
    //    guard) ─────────────────────────────────────────────────────────────
    // Server-internal bookkeeping only (Phase 13 cost protection) — never
    //   read or written by any client, regardless of role.
    match /aiAssistantRateLimit/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // Deny-all default. Every business collection must add an explicit block
    // above this wildcard in the same PR that introduces the collection
    // (Doc 09 §4 PR checklist). Hard `delete` stays false everywhere (ADR-009).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
