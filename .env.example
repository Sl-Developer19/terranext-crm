# TerraNext Business OS — environment contract (validated in src/lib/env.ts)
# Copy to .env.local and fill from Firebase console → project settings → web app config.
# NEXT_PUBLIC_* values are public client config, not secrets (Doc 10 §5).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=terranextglobal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (Admin SDK uses Application Default Credentials in deployed
# environments; for local dev point to a service-account key file OUTSIDE the repo)
# GOOGLE_APPLICATION_CREDENTIALS=

# Emulators (local development)
# NEXT_PUBLIC_USE_EMULATORS=true

# ── Scheduled jobs (Doc 24 §4) ────────────────────────────────────────────
# Bearer token Cloud Scheduler presents to /api/jobs/*.
# Generate: openssl rand -base64 48
# UNSET = every job endpoint refuses all requests (deliberately fail-closed).
JOBS_SECRET=

# ── Messaging providers (Doc 24 §1.3) ─────────────────────────────────────
# Only the API KEY is required — the sender identity defaults to the business
# values in src/config/organisation.ts. Unset provider/key = messages are
# logged and stay `queued`, never silently "sent".
# EMAIL_PROVIDER=resend        # resend | sendgrid
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ── Sender identity overrides (defaults in src/config/organisation.ts) ─────
# Defaults: "TerraNext Global Ventures" <pp@terranextglobal.com>, +91 81243 60360.
# Override in staging so a test deploy does not send as the live business.
# EMAIL_FROM=pp@terranextglobal.com
# EMAIL_FROM_NAME=TerraNext Global Ventures
# EMAIL_REPLY_TO=pp@terranextglobal.com
# ORG_CONTACT_PHONE=+918124360360
# ORG_CONTACT_PHONE_DISPLAY=+91 81243 60360

# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+919876543210    # WhatsApp reuses this with a whatsapp: prefix

# ── Public website intake (Doc 20 §2) ─────────────────────────────────────
# Comma-separated origins allowed to POST /api/createLead.
# Defaults to production domains in src/config/public-intake.ts.
# PUBLIC_INTAKE_ORIGINS=https://terranextglobal.com,https://www.terranextglobal.com
