# Cloud Functions runtime parameters (firebase-functions/params).
# Copy to functions/.env (gitignored) for local emulation, or set in the
# Firebase console / `firebase functions:secrets:set` for deployed envs.

# Target bucket (name only, no gs:// prefix) for the weekly Firestore export
# (Doc 23 §3 binding amendment, Doc 19 §4 scheduledFirestoreExport).
# Manual one-time setup required — see docs/19-cloud-function-inventory.md §4.
FIRESTORE_EXPORT_BUCKET=terranextglobal-firestore-exports

# ── AI Intelligence Platform (functions/src/ai) ─────────────────────────
# OPENAI_API_KEY is a SECRET, not a plain param — never put a real value
# here. Set it with:
#   firebase functions:secrets:set OPENAI_API_KEY
# For local emulation only, Firebase supports a gitignored
# functions/.secret.local file (OPENAI_API_KEY=sk-...) that the emulator
# reads automatically — see
# https://firebase.google.com/docs/functions/config-env#local-secret-access

# Which vendor is active. Defaults to 'openai' in code (providers/factory.ts)
# — only set these if you want to force 'mock' (e.g. a demo/test deploy
# without burning real API credits). OpenAI is the only real provider;
# there is no other vendor to switch to.
# AI_SPEECH_PROVIDER=openai
# AI_SUMMARY_PROVIDER=openai

# Model overrides — both already default sensibly in providers/factory.ts;
# only set these to change them.
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
