rules_version = '2';

// TerraNext Business OS — Firestore Security Rules
// Strategy: Doc 10 §3 · Access truth table: Doc 18 (Firestore Rules Matrix)
//
// M1 baseline: DEFAULT DENY everywhere. Per-collection blocks are added
// module-by-module, generated/verified against lib/rbac/permissions.ts
// (condition C-1) with emulator allow+deny tests per Doc 18.
//
// Until the auth/RBAC foundation lands in this milestone, no client has any
// read or write access. Platform collections (users, settings, auditLogs) are
// written exclusively via the Admin SDK, which bypasses rules by design —
// client access to them will be opened by explicit blocks with role predicates.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared predicates ────────────────────────────────────────────────────
    // isStaff(): valid session cookie with a known role claim.
    // Role predicates used here are literal string checks — the C-1 codegen
    // will generate the full can(module, action) expansion from permissions.ts.
    function isStaff() {
      return request.auth != null && request.auth.token.role != null;
    }

    function hasRole(r) {
      return isStaff() && request.auth.token.role == r;
    }

    function isFounderOrAdmin() {
      return hasRole('founder') || hasRole('system_admin');
    }

    // ── Login-security ledger (Doc 10 §1 / ADR-013): server-only forever. ──
    // Written exclusively by the Admin SDK from /api/auth/login; no client
    // (any role, any claim) may ever read attempt counters, lockout state,
    // access-log entries, or security events.
    match /loginSecurity/{emailHash} {
      allow read, write: if false;
    }
    match /loginAttempts/{attemptId} {
      allow read, write: if false;
    }
    match /securityEvents/{eventId} {
      allow read, write: if false;
    }

    // ── auditLogs (Doc 18, ADR-007: create-only, immutable) ─────────────────
    // Read: system_admin + founder only (Doc 04 §3, SOP 17.16).
    // Create: any authenticated staff member may write their own audit entry
    //   (actorUid == auth.uid, valid shape). Admin SDK bypasses this.
    // Update/delete: false for everyone, forever (ADR-007 — immutability absolute).
    match /auditLogs/{logId} {
      allow read: if isFounderOrAdmin();
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.entityType is string;
      allow update, delete: if false;
    }

    // ── settings/* (Doc 18, Doc 03 §1.1) ────────────────────────────────────
    // Read: all authenticated staff (org info, ID formats, etc. are not sensitive).
    // Write: Admin SDK only (system_admin caller — enforced in the server action).
    //   Rules deny client writes; the action uses Admin SDK which bypasses rules.
    match /settings/{settingKey} {
      allow read: if isStaff();
      allow write: if false; // Admin SDK only
    }

    // ── counters/* ───────────────────────────────────────────────────────────
    // Transaction-only via Admin SDK. Client has no access.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // ── users/* (Doc 18) ────────────────────────────────────────────────────
    // Read: self (any staff), founder + system_admin (all users).
    // Write: Admin SDK only (provisionUser / setUserRole / setUserStatus).
    //   Self may update photoUrl via a dedicated server action.
    match /users/{uid} {
      allow read: if isStaff() && (
        request.auth.uid == uid || isFounderOrAdmin()
      );
      allow write: if false; // Admin SDK only
    }

// <<GENERATED_RBAC_START>>
    // ── GENERATED RBAC predicates (condition C-1) ──────────────────────────
    // Source: lib/rbac/permissions.ts · map-version: 21E52FC1
    // DO NOT EDIT this block manually — run scripts/generate-firestore-predicates.mts
    // and commit the result. CI will fail if this block has drifted.
    //
    // can(module, action): returns true when request.auth has a role that
    // grants the given module:action. Mirrors ROLE_PERMISSIONS exactly.

    function can_dashboard_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin', 'ops_manager', 'consultant', 'coordinator', 'trainer', 'finance', 'placement'];
    }
    function can_dashboard_export() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_leads_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant'];
    }
    function can_leads_create() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'consultant'];
    }
    function can_leads_update() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'consultant'];
    }
    function can_leads_delete() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_leads_assign() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_leads_export() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_counselling_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant'];
    }
    function can_counselling_create() {
      return isStaff() && request.auth.token.role in ['consultant'];
    }
    function can_counselling_update() {
      return isStaff() && request.auth.token.role in ['consultant'];
    }
    function can_admissions_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_admissions_create() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_participants_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant', 'coordinator', 'trainer', 'finance', 'placement'];
    }
    function can_participants_create() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_participants_update() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'coordinator'];
    }
    function can_participants_export() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_programmes_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant', 'coordinator', 'trainer', 'placement'];
    }
    function can_programmes_create() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'coordinator'];
    }
    function can_programmes_update() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'coordinator'];
    }
    function can_programmes_configure() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_batches_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'coordinator', 'trainer', 'placement'];
    }
    function can_batches_create() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'coordinator'];
    }
    function can_batches_update() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'coordinator'];
    }
    function can_batches_assign() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'coordinator'];
    }
    function can_attendance_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'coordinator', 'trainer'];
    }
    function can_attendance_create() {
      return isStaff() && request.auth.token.role in ['trainer'];
    }
    function can_attendance_update() {
      return isStaff() && request.auth.token.role in ['coordinator', 'trainer'];
    }
    function can_attendance_export() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_assessments_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'coordinator', 'trainer', 'placement'];
    }
    function can_assessments_create() {
      return isStaff() && request.auth.token.role in ['coordinator', 'trainer'];
    }
    function can_assessments_update() {
      return isStaff() && request.auth.token.role in ['coordinator', 'trainer'];
    }
    function can_certificates_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'coordinator', 'trainer', 'placement'];
    }
    function can_certificates_create() {
      return isStaff() && request.auth.token.role in ['coordinator'];
    }
    function can_certificates_approve() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_certificates_configure() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_career_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant', 'placement'];
    }
    function can_career_create() {
      return isStaff() && request.auth.token.role in ['placement'];
    }
    function can_career_update() {
      return isStaff() && request.auth.token.role in ['placement'];
    }
    function can_placements_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'placement'];
    }
    function can_placements_create() {
      return isStaff() && request.auth.token.role in ['placement'];
    }
    function can_placements_update() {
      return isStaff() && request.auth.token.role in ['placement'];
    }
    function can_placements_export() {
      return isStaff() && request.auth.token.role in ['founder', 'placement'];
    }
    function can_employers_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'placement'];
    }
    function can_employers_create() {
      return isStaff() && request.auth.token.role in ['placement'];
    }
    function can_employers_update() {
      return isStaff() && request.auth.token.role in ['placement'];
    }
    function can_alumni_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant', 'coordinator', 'placement'];
    }
    function can_alumni_create() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_alumni_update() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_alumni_export() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_fees_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'finance'];
    }
    function can_fees_create() {
      return isStaff() && request.auth.token.role in ['finance'];
    }
    function can_fees_update() {
      return isStaff() && request.auth.token.role in ['finance'];
    }
    function can_fees_approve() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager'];
    }
    function can_fees_export() {
      return isStaff() && request.auth.token.role in ['founder', 'finance'];
    }
    function can_communications_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant', 'coordinator', 'trainer', 'finance', 'placement'];
    }
    function can_communications_create() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'consultant', 'coordinator', 'trainer', 'finance', 'placement'];
    }
    function can_communications_configure() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_reports_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant', 'coordinator', 'trainer', 'finance', 'placement'];
    }
    function can_reports_export() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'finance', 'placement'];
    }
    function can_colleges_view() {
      return isStaff() && request.auth.token.role in ['founder', 'ops_manager', 'consultant'];
    }
    function can_colleges_create() {
      return isStaff() && request.auth.token.role in ['ops_manager'];
    }
    function can_colleges_update() {
      return isStaff() && request.auth.token.role in ['ops_manager', 'consultant'];
    }
    function can_users_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_users_create() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_users_update() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_roles_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_roles_configure() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_audit_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_audit_export() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }
    function can_settings_view() {
      return isStaff() && request.auth.token.role in ['founder', 'system_admin'];
    }
    function can_settings_configure() {
      return isStaff() && request.auth.token.role in ['system_admin'];
    }

    // Usage in rules: instead of 'can("leads", "view")',
    // call can_leads_view(), can_users_create(), etc.
    // <<GENERATED_RBAC_END>>

    // Deny-all default. Every business collection must add an explicit block
    // above this wildcard in the same PR that introduces the collection
    // (Doc 09 §4 PR checklist). Hard `delete` stays false everywhere (ADR-009).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
