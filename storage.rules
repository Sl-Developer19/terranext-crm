rules_version = '2';

// TerraNext Business OS — Storage Rules (strategy: Doc 10 §4)
// M1 baseline: default deny. Uploads flow through the signed-URL ticket flow
// (Doc 10 §6) — direct client SDK writes to arbitrary paths are never enabled.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
