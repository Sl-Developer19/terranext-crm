# TerraNext Business OS — environment contract (validated in src/lib/env.ts)
# Copy to .env.local and fill from Firebase console → project settings → web app config.
# NEXT_PUBLIC_* values are public client config, not secrets (Doc 10 §5).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=terranextglobal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (Admin SDK uses Application Default Credentials in deployed
# environments; for local dev point to a service-account key file OUTSIDE the repo)
# GOOGLE_APPLICATION_CREDENTIALS=

# Emulators (local development)
# NEXT_PUBLIC_USE_EMULATORS=true
